@@ -1197,2 +1208,100 @@ export function setReadonlyMode(readonly: boolean): void {
 
+function getEditorFrame(): HTMLIFrameElement | null {
+  return document.querySelector<HTMLIFrameElement>('#iframe iframe, iframe[name="frameEditor"]');
+}
+
+function installPrintBridge(attempt = 0): void {
+  const editorFrame = getEditorFrame();
+  const editorDocument = editorFrame?.contentDocument;
+  if (!editorDocument) {
+    if (attempt < 30) window.setTimeout(() => installPrintBridge(attempt + 1), 200);
+    return;
+  }
+
+  const root = editorDocument.documentElement;
+  if (root.dataset.ranutsPrintBridge === 'ready') return;
+  root.dataset.ranutsPrintBridge = 'ready';
+  editorDocument.addEventListener(
+    'click',
+    (event) => {
+      if (nativePrintBypass || !isEmbedMode()) return;
+      const target = event.target;
+      if (!target || typeof (target as Element).closest !== 'function') return;
+      const targetElement = target as Element;
+      const printButton = targetElement.closest('button, [role="button"]');
+      const printIcon = targetElement.closest('.btn-print') || printButton?.querySelector('.btn-print');
+      if (!printIcon || !printButton) return;
+      event.preventDefault();
+      event.stopPropagation();
+      window.dispatchEvent(new CustomEvent('ranuts:document-native-print'));
+    },
+    true,
+  );
+}
+
+export function renameOpenDocument(fileName: string): void {
+  const nextName = String(fileName || '').trim();
+  if (!nextName) {
+    throw new Error('Document name cannot be empty');
+  }
+
+  const documentObject = getDocmentObj();
+  const file = documentObject.file
+    ? new File([documentObject.file], nextName, {
+        type: documentObject.file.type,
+        lastModified: documentObject.file.lastModified,
+      })
+    : undefined;
+
+  setDocmentObj({
+    ...documentObject,
+    fileName: nextName,
+    file,
+  });
+  editorSendCommand({
+    command: 'asc_setDocumentName',
+    data: nextName,
+  });
+  focusOpenDocument();
+}
+
+export function requestNativeBrowserPrint(): void {
+  const editorFrame = getEditorFrame();
+  const printButton = editorFrame?.contentDocument?.querySelector<HTMLElement>('.btn-print')?.closest<HTMLButtonElement>('button');
+  if (!editorFrame?.contentWindow || !printButton) {
+    throw new Error('A impressão nativa do OnlyOffice não está disponível para este documento.');
+  }
+  nativePrintBypass = true;
+  printButton.click();
+  window.setTimeout(() => {
+    nativePrintBypass = false;
+  }, 0);
+}
+
+export function focusOpenDocument(): void {
+  cancelPendingDocumentFocus();
+  const applyFocus = () => {
+    const editorFrame = getEditorFrame();
+    editorFrame?.focus({ preventScroll: true });
+    editorFrame?.contentWindow?.focus();
+    (window.editor as any)?.grabFocus?.();
+  };
+
+  applyFocus();
+  focusAnimationFrame = window.requestAnimationFrame(applyFocus);
+  focusTimeout = window.setTimeout(applyFocus, 80);
+}
+
+export function blurOpenDocument(): void {
+  cancelPendingDocumentFocus();
+  (window.editor as any)?.blurFocus?.();
+}
+
+function cancelPendingDocumentFocus(): void {
+  if (focusAnimationFrame) window.cancelAnimationFrame(focusAnimationFrame);
+  if (focusTimeout) window.clearTimeout(focusTimeout);
+  focusAnimationFrame = 0;
+  focusTimeout = 0;
+}
