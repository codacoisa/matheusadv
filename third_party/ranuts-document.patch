+async function handleNativePrintRequest(): Promise<void> {
+  if (printRequestInProgress) {
+    return;
+  }
+
+  printRequestInProgress = true;
+  postToParent('document:print-started');
+  try {
+    const fileName = getDocmentObj()?.fileName || '';
+    if (/\.(?:docx?|dotx?)$/i.test(fileName)) {
+      try {
+        requestNativeBrowserPrint();
+        postToParent('document:print-native', { fileName });
+      } catch (error) {
+        postToParent('document:error', {
+          message: error instanceof Error ? error.message : String(error),
+          operation: 'print',
+        });
+      }
+      return;
+    }
+    const file = await requestSaveDocument('PDF');
+    postToParent('document:print-ready', {
+      file,
+      fileName: file.name,
+      mimeType: file.type || 'application/pdf',
+      size: file.size,
+    });
+  } catch (error) {
+    try {
+      requestNativeBrowserPrint();
+      postToParent('document:print-fallback', {
+        message: 'A conversão para PDF não foi compatível com este arquivo. A impressão nativa do OnlyOffice foi aberta.',
+        conversionError: error instanceof Error ? error.message : String(error),
+      });
+    } catch (fallbackError) {
+      postToParent('document:error', {
+        message: fallbackError instanceof Error ? fallbackError.message : String(fallbackError),
+        operation: 'print',
+      });
+    }
+  } finally {
+    printRequestInProgress = false;
+  }
+}
